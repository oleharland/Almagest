---
import Base from '../layouts/Base.astro';
import PageList from '../components/PageList.astro';
import siteConfig from '../../site.config';
import { getPages, groupPages, allTags } from '../lib/wiki';

const pages = getPages();
const groups = groupPages(pages, siteConfig.groupBy);
const tags = allTags(pages);
const sourceCount = new Set(pages.flatMap((p) => p.sourcePaths)).size;
const needsAttention = pages.filter((p) => p.status === 'stub' || p.brokenLinks.length > 0).length;
---

<Base current="pages">
  <div class="al-pagehead">
    <h1>{siteConfig.title}</h1>
    <p class="al-lede">{siteConfig.description}</p>
  </div>

  <ul class="al-stats" role="list">
    <li class="al-stat"><strong class="al-stat__value">{pages.length}</strong> pages</li>
    <li class="al-stat"><strong class="al-stat__value">{groups.length}</strong> {siteConfig.groupBy === 'type' ? 'types' : 'tiers'}</li>
    <li class="al-stat"><strong class="al-stat__value">{sourceCount}</strong> sources</li>
    <li class="al-stat"><strong class="al-stat__value">{tags.length}</strong> tags</li>
    {needsAttention > 0 && <li class="al-stat"><strong class="al-stat__value">{needsAttention}</strong> need attention</li>}
  </ul>

  {pages.length === 0 ? (
    <div class="al-empty index-group">
      <p class="al-empty__title">No pages yet.</p>
      <p>
        Drop a file into <code>brain/raw/</code> and start your coding agent in the repo root.
        It will propose your first wiki pages.
      </p>
    </div>
  ) : (
    <>
      <label class="al-visually-hidden" for="filter">Filter pages</label>
      <input
        class="al-input index-filter"
        id="filter"
        type="search"
        placeholder="Filter pages by title, tag, or type…"
        autocomplete="off"
      />

      {groups.map((group) => (
        <section class="al-section" data-group>
          <h2 class="al-section__title">{group.name}<span class="al-section__count">{group.pages.length}</span></h2>
          <PageList pages={group.pages} />
        </section>
      ))}

      <p class="al-empty index-group" data-no-results hidden>No pages match that filter.</p>
    </>
  )}

  <script is:inline>
    const input = document.getElementById('filter');
    if (input) {
      const groups = [...document.querySelectorAll('[data-group]')];
      const noResults = document.querySelector('[data-no-results]');

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let total = 0;

        for (const group of groups) {
          let shown = 0;
          for (const item of group.querySelectorAll('[data-search]')) {
            const match = !q || item.dataset.search.includes(q);
            item.hidden = !match;
            if (match) shown++;
          }
          group.hidden = shown === 0;
          const count = group.querySelector('h2 span');
          if (count) count.textContent = String(shown);
          total += shown;
        }

        if (noResults) noResults.hidden = total !== 0;
      });
    }
  </script>
</Base>
