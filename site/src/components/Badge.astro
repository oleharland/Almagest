---
interface Props {
  label: string;
  kind?: string;
}
const { label, kind } = Astro.props;
const isTier = kind === 'canonical' || kind === 'curated' || kind === 'evidence';
---
{isTier
  ? <span class={`al-tier al-tier--${kind}`}>{label}</span>
  : <span class:list={['al-badge', kind === 'stub' && 'al-badge--quiet']}>{label}</span>}
