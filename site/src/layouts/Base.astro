---
import siteConfig from '../../site.config';
import '../styles/base.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  /** Which nav link is current: 'pages' for the index and wiki pages, 'gallery' for the dev gallery. */
  current?: string;
}

const { title, description = siteConfig.description, current = '' } = Astro.props;
const fullTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const frameworkUrl = siteConfig.frameworkUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('almagest-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="al-skip-link" href="#main">Skip to content</a>
    <header class="al-appbar">
      <div class="al-page al-appbar__inner">
        <a class="al-appbar__brand" href="/">{siteConfig.title}</a>
        <nav class="al-appbar__nav" aria-label="Site">
          <a class="al-appbar__link" href="/" aria-current={current === 'pages' ? 'page' : undefined}>Pages</a>
          {import.meta.env.DEV && <a class="al-appbar__link" href="/gallery/" aria-current={current === 'gallery' ? 'page' : undefined}>Gallery</a>}
          {siteConfig.repoUrl && <a class="al-appbar__link" href={siteConfig.repoUrl} rel="noopener">Source</a>}
        </nav>
        <div class="al-appbar__end">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
            <span aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="al-main al-page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="al-page">
        Built with {frameworkUrl ? <a href={frameworkUrl} rel="noopener">Almagest</a> : 'Almagest'}.
        Every claim on this site should cite its source. If one doesn't, that's a bug.
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        // Stop every transition for one frame so the switch does not smear.
        root.setAttribute('data-theme-switching', '');
        root.dataset.theme = next;
        try { localStorage.setItem('almagest-theme', next); } catch (e) {}
        requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-theme-switching')));
      });
    </script>
  </body>
</html>
