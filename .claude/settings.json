{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(grep:*)",
      "Bash(basename:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c ingest/*)",
      "Bash(git checkout -b ingest/*)",
      "Bash(git stash:*)",
      "Bash(git remote -v)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npx astro:*)",
      "Bash(node tools/audit.mjs:*)",
      "Bash(node tools/lib/selftest.mjs:*)",
      "Bash(node server/bin/almagest.mjs help)",
      "Bash(node server/bin/almagest.mjs doctor:*)",
      "Bash(node server/bin/almagest.mjs hooks check:*)",
      "Bash(node server/bin/almagest.mjs jobs:*)",
      "Bash(node server/bin/almagest.mjs proposals:*)",
      "Bash(node server/bin/almagest.mjs gaps:*)",
      "Bash(node server/bin/almagest.mjs connectors list:*)",
      "Bash(curl -s -o /dev/null:*)",
      "Bash(lsof -ti:*)",
      "Bash(pkill -f \"astro\")",
      "Bash(pkill -f \"node\")",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git update-ref:*)",
      "Bash(git -c core.hooksPath:*)",
      "Bash(git checkout -B:*)",
      "Bash(git switch -C:*)",
      "Bash(git switch --force-create:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch -C:*)",
      "Bash(git reset --soft:*)",
      "Bash(git reset --mixed:*)",
      "Bash(git reset --keep:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git config --unset core.hooksPath:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(node server/bin/almagest.mjs login:*)",
      "Bash(node server/bin/almagest.mjs hooks install:*)",
      "Bash(curl *inbox/login*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/server/bin/almagest.mjs\" hook guard-wiki",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/server/bin/almagest.mjs\" hook guard-git",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/server/bin/almagest.mjs\" hook enqueue",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/server/bin/almagest.mjs\" hook status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
