{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN:-}"
      }
    },
    "gitlab": {
      "type": "http",
      "url": "${GITLAB_URL:-https://gitlab.com}/api/v4/mcp",
      "headers": {
        "PRIVATE-TOKEN": "${GITLAB_TOKEN:-}"
      }
    }
  }
}
