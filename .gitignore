node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*

# Instance-specific settings (not shared)
.claude/settings.local.json

# Raw processed ORIGINALS — reference material, not wiki content.
# Text files (md, json, csv, txt, srt) are tracked; binaries are local-only,
# because a repo is not a file server and 2 GB of PDFs helps nobody clone it.
#
# The originals being absent from a clone used to make every citation into them
# permanently unverifiable. It no longer does: each binary source is committed as
# a plain-text sidecar under `brain/raw/extracted/` (see below), and that sidecar
# — not the original — is what wiki pages cite.
brain/raw/processed/*.mp4
brain/raw/processed/*.mov
brain/raw/processed/*.png
brain/raw/processed/*.jpg
brain/raw/processed/*.jpeg
brain/raw/processed/*.gif
brain/raw/processed/*.pdf
brain/raw/processed/*.docx
brain/raw/processed/*.pptx
brain/raw/processed/*.xlsx
brain/raw/processed/*.htm
brain/raw/processed/*.html
brain/raw/processed/*.js
brain/raw/processed/*.css
brain/raw/processed/*.svg
brain/raw/processed/*.flsnp
brain/raw/processed/*.sample

# Extracted text sidecars — COMMITTED, deliberately.
# One `.txt` per binary source, full text with `=== page n ===` markers, so every
# `[source: <id>, p.12]` on a wiki page can be checked by anyone with a clone and
# by `tools/audit.mjs`. This is the evidence behind the receipts in
# `brain/manifest.yaml`. Nothing here is ignored — do not add exclusions.
!brain/raw/extracted/
!brain/raw/extracted/**

# Old Obsidian/Claude config from imported vaults
brain/raw/**/.obsidian/
brain/raw/**/.claude/

# Benchmark run output — answers, timings, judge verdicts, rendered reports.
# Regenerated by benchmarks/run.sh; never committed, so no result can be quoted
# from the repo that was not produced by running the harness.
benchmarks/results/

# Almagest service state — database, worktrees, spool, demand export.
# Operational, per-machine, never committed. See docs/v2/spec.md.
.almagest/
